{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // Throwaway Worker for the Clef end-of-turn spike (issue #117). Delete it after the run.
  "name": "kelpie-spike-clef",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // Clef's answers are measured from the caller's side; the Worker writes no logs of its own.
  "observability": { "enabled": false },
  // The only public surface is POST /qualify on workers.dev, behind x-spike-token.
  "workers_dev": true,
  "preview_urls": false,
  // Clef runs on Workers AI, billed to the account; no API key is involved.
  "ai": { "binding": "AI" },
  "secrets": {
    // SPIKE_TOKEN: the value callers send in x-spike-token. It guards the account's Workers AI usage.
    "required": ["SPIKE_TOKEN"]
  }
}
