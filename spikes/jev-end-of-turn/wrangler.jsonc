{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // Throwaway Worker for the Jev end-of-turn spike (issue #27). Delete it after the run.
  "name": "kelpie-spike-jev",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // Jev's answers are measured from the caller's side; the Worker writes no logs of its own.
  "observability": { "enabled": false },
  // The only public surface is POST /qualify on workers.dev, behind x-spike-token.
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    // Pinned, as TypeSafe recommends when thresholds are tuned against a version.
    "JEV_MODEL": "jev-1.13.0"
  },
  "secrets": {
    // TYPESAFE_API_KEY: the owner's key from console.typesafe.ai. Jev is called directly.
    // SPIKE_TOKEN: the value callers send in x-spike-token. It guards the owner's TypeSafe credits.
    "required": ["TYPESAFE_API_KEY", "SPIKE_TOKEN"]
  }
}
