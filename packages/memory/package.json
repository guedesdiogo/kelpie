{
  "name": "@kelpie/memory",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "types": "wrangler types -c test/wrangler.jsonc test/worker-configuration.d.ts",
    "typecheck": "bun run types > /dev/null && tsc --noEmit -p tsconfig.json && tsc --noEmit -p test/tsconfig.json",
    "test": "vitest run",
    "eval": "vitest run --config vitest.eval.config.ts",
    "eval:baseline": "node eval/baseline.mjs"
  },
  "dependencies": {
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.3.6",
    "vitest": "^4.1.0",
    "wrangler": "^4.147.0"
  }
}
