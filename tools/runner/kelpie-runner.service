# Kelpie's runner, as a systemd user service (docs/runner.md). Copy it to
# ~/.config/systemd/user/ and adjust the two paths if the checkout or Bun live elsewhere.
[Unit]
Description=Kelpie's runner

[Service]
Type=simple
WorkingDirectory=%h/kelpie
ExecStart=%h/.bun/bin/bun tools/runner/src/main.ts
Restart=on-failure
RestartSec=5
# Exit 78 is a setting to fix, such as a missing secret: restarting wouldn't help.
RestartPreventExitStatus=78
# Every process the runner starts inherits it: none can gain privileges, through sudo or setuid.
NoNewPrivileges=true
# Files the runner writes are its user's alone.
UMask=0077
# The runner keeps at most 4 Claude Code sessions live, of about 285 MB and 20 threads each. These
# bounds leave room for them, one more closing, and the runner: past MemoryHigh the kernel reclaims
# memory, and at MemoryMax it kills a process of the service rather than starve the server.
MemoryHigh=1536M
MemoryMax=2G
TasksMax=256
Environment=NODE_ENV=production

[Install]
WantedBy=default.target
