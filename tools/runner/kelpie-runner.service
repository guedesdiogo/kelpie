# Kelpie's runner, as a systemd user service (docs/runner.md). Copy it to ~/.config/systemd/user/.
# It runs the checkout in ~/Repos/kelpie with the Bun in ~/.bun: adjust both paths if they live
# elsewhere.
[Unit]
Description=Kelpie's runner

[Service]
Type=simple
WorkingDirectory=%h/Repos/kelpie
ExecStart=%h/.bun/bin/bun tools/runner/src/main.ts
Restart=on-failure
RestartSec=5
# Exit 78 is a setting to fix, such as a missing secret: restarting wouldn't help.
RestartPreventExitStatus=78
# Every process the runner starts inherits it: none can gain privileges, through sudo or setuid.
NoNewPrivileges=true
# Files the runner writes are its user's alone.
UMask=0077
# The runner keeps at most 4 Claude Code sessions live, of up to about 420 MB and 20 threads each,
# and one more while a closed one exits: with the runner, about 2.2 GB. Past MemoryHigh the kernel
# reclaims the service's memory. At MemoryMax its OOM killer kills one process, most likely a
# session's, and OOMPolicy=continue keeps the unit up: that session's turn fails and it closes.
# systemd's default, stop, would stop the whole runner.
MemoryHigh=2560M
MemoryMax=3G
OOMPolicy=continue
TasksMax=256
Environment=NODE_ENV=production

[Install]
WantedBy=default.target
