{
  "name": "@kelpie/ingress",
  "private": true,
  "type": "module",
  "scripts": {
    "types": "wrangler types src/worker-configuration.d.ts",
    "typecheck": "bun run types > /dev/null && tsc --noEmit -p tsconfig.json && tsc --noEmit -p test/tsconfig.json",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.3.6",
    "drizzle-kit": "0.31.11",
    "vitest": "^4.1.0",
    "wrangler": "^4.147.0"
  },
  "dependencies": {
    "@kelpie/access": "workspace:*",
    "@kelpie/channels": "workspace:*",
    "drizzle-orm": "0.45.3"
  }
}
