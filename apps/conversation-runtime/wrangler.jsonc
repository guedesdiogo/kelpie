{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "kelpie-conversation-runtime",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // The Agents SDK uses AsyncLocalStorage.
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Drizzle's Durable Object migrations import .sql files as text.
  "rules": [{ "type": "Text", "globs": ["**/*.sql"], "fallthrough": true }],
  "services": [
    { "binding": "LLM_GATEWAY", "service": "kelpie-llm-gateway", "entrypoint": "LlmGateway" },
    // A conversation's calls with its session, the only ones that reach the claude-code route on
    // the owner's subscription (#431). Only this Worker binds it.
    { "binding": "LLM_CHAT", "service": "kelpie-llm-gateway", "entrypoint": "LlmChat" },
    // The instance's model settings, for Master's configuration tools only (#289).
    {
      "binding": "LLM_GATEWAY_ADMIN",
      "service": "kelpie-llm-gateway",
      "entrypoint": "LlmGatewayAdmin"
    },
    {
      "binding": "CHANNEL_EGRESS",
      "service": "kelpie-channel-egress",
      "entrypoint": "ChannelEgress"
    },
    // The vault's persona, rules and skills (ADR-0005).
    { "binding": "CONTEXT_STORE", "service": "kelpie-context-store", "entrypoint": "ContextStore" },
    // Master's tools open a secure form for a bot's token, and nothing more (Story 3.11).
    { "binding": "SETUP_FORMS", "service": "kelpie-channel-egress", "entrypoint": "SetupForms" },
    // The VPS's Claude Code sessions, read only, for Master's vps_sessions tool and the notices of
    // waits on the owner (ADR-0057 §5, #434).
    {
      "binding": "RUNNER_SESSIONS",
      "service": "kelpie-channel-egress",
      "entrypoint": "RunnerSessions"
    }
  ],
  // The admin API's public origin, for Master's links; set when deploying (Story 3.11).
  "vars": { "ADMIN_ORIGIN": "" },
  "durable_objects": {
    "bindings": [
      { "name": "CONVERSATION_AGENT", "class_name": "ConversationAgent" },
      { "name": "AGENT_HOST", "class_name": "AgentHost" },
      { "name": "REGISTRY", "class_name": "Registry" }
    ]
  },
  // Never deployed with DebounceBuffer, so the first migration names the real class.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ConversationAgent"] },
    { "tag": "v2", "new_sqlite_classes": ["AgentHost", "Registry"] }
  ]
}
