{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "kelpie-channel-egress",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  // Reached only through service bindings from Kelpie's other Workers.
  "workers_dev": false,
  "preview_urls": false,
  // Drizzle's Durable Object migrations import .sql files as text, and the bot's photo imports the
  // webchat's mascot files, linked in src/photo/webchat as .txt (ADR-0046).
  "rules": [{ "type": "Text", "globs": ["**/*.sql", "**/*.txt"], "fallthrough": true }],
  // The key that encrypts the secret store (ADR-0013): 32 random bytes, base64. `docs/secrets.md`
  // says how to make it.
  "secrets": { "required": ["SECRETS_KEY"] },
  // Ingress's public origin (`https://<ingress hostname>`), where bots' webhooks point. It belongs to
  // one deployment, so it goes in as a `--var` flag when deploying (docs/secrets.md); while it is
  // empty, no webhook is registered.
  "vars": { "INGRESS_ORIGIN": "" },
  "durable_objects": {
    "bindings": [
      { "name": "SECRET_STORE", "class_name": "SecretStore" },
      { "name": "BOT_PHOTO", "class_name": "BotPhoto" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["SecretStore"] },
    { "tag": "v2", "new_sqlite_classes": ["BotPhoto"] }
  ],
  // Browser Run draws each bot's photo (ADR-0046). Workers Paid includes 10 browser hours a month,
  // and a photo takes about 15 s.
  "browser": { "binding": "BROWSER" }
}
