{
  "name": "@kelpie/admin-api",
  "private": true,
  "type": "module",
  "scripts": {
    "types": "wrangler types src/worker-configuration.d.ts",
    "typecheck": "bun run types > /dev/null && tsc --noEmit -p tsconfig.json && tsc --noEmit -p test/tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@kelpie/access": "workspace:*",
    "@kelpie/channels": "workspace:*",
    "@kelpie/config": "workspace:*",
    "@kelpie/context-store": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.3.6",
    "@vitest/coverage-istanbul": "^4.1.0",
    "vitest": "^4.1.0",
    "wrangler": "^4.147.0"
  }
}
