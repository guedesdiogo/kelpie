{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "kelpie-admin-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // Invocation logs record request URLs, and a form's URL carries its one-time token.
  "observability": { "enabled": true, "logs": { "invocation_logs": false } },
  // Reachable only through a custom domain behind a Cloudflare Access application, added at deploy.
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    // Set from the Access application at deploy. While either is empty, every request is refused.
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": ""
  },
  // The first-run token (ADR-0013); `docs/admin-api.md` says how to make one. A `RECOVERY_TOKEN`
  // secret is set only while the owner recovers a changed Access login, so it isn't required here.
  "secrets": { "required": ["BOOTSTRAP_TOKEN"] },
  // Secure forms for channel secrets; channel-egress holds the secret store (docs/secrets.md).
  "services": [
    { "binding": "CHANNEL_FORMS", "service": "kelpie-channel-egress", "entrypoint": "ChannelForms" }
  ],
  // The objects that hold configuration live in the Workers that run them.
  "durable_objects": {
    "bindings": [
      { "name": "DIRECTORY", "class_name": "Directory", "script_name": "kelpie-ingress" },
      {
        "name": "REGISTRY",
        "class_name": "Registry",
        "script_name": "kelpie-conversation-runtime"
      },
      {
        "name": "AGENT_HOST",
        "class_name": "AgentHost",
        "script_name": "kelpie-conversation-runtime"
      }
    ]
  }
}
