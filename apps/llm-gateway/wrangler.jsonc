{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "kelpie-llm-gateway",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  // Reached only through service bindings from Kelpie's other Workers.
  "workers_dev": false,
  "preview_urls": false,
  // Clef, the default end-of-turn qualifier, runs on Workers AI and needs no key (issue #118).
  "ai": { "binding": "AI" },
  // The instance's model settings and its pinned provider (ADR-0036 §2, #286).
  "durable_objects": {
    "bindings": [{ "name": "MODEL_DEFAULTS", "class_name": "ModelDefaults" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ModelDefaults"] }],
  // The `claude-code` route's way to the VPS runner (ADR-0037, #295): channel-egress's entrypoint,
  // which holds the runner's secret and can't open forms. The route serves only once the owner turns
  // it on (docs/admin-api.md), so channel-egress deploys first.
  "services": [
    { "binding": "RUNNER_CHAT", "service": "kelpie-channel-egress", "entrypoint": "RunnerChat" },
    // The model keys the owner set through a one-time form (ADR-0068 §3): channel-egress returns
    // them to this Worker alone, which prefers them to its Worker secrets.
    { "binding": "PROVIDER_KEYS", "service": "kelpie-channel-egress", "entrypoint": "ProviderKeys" }
  ],
  "vars": {
    // To go through AI Gateway, override these with --var when deploying (docs/admin-api.md),
    // so the instance's account id stays out of the repository:
    // https://gateway.ai.cloudflare.com/v1/<account>/<gateway>/anthropic and .../openai
    "ANTHROPIC_BASE_URL": "https://api.anthropic.com",
    "OPENAI_BASE_URL": "https://api.openai.com/v1",
    // Jev's version for end of turn, pinned: its thresholds were measured on it (ADR-0018).
    "JEV_MODEL": "jev-1.13.0",
    // Clef's model for end of turn, "clef" or "clef-flash", pinned like Jev's: each has its own
    // bands (ADR-0022).
    "CLEF_MODEL": "clef",
    // The vault's embedding model: "workers-ai" (bge-m3) or "openai" (text-embedding-3-small).
    "EMBEDDING_PROVIDER": "workers-ai",
    // For each tier, the models to try in order. Owner configuration; edit freely.
    // "haiku" is Kelpie's alias for the newest Claude Haiku, looked up in Anthropic's Models API
    // once an hour; a pinned id such as "claude-haiku-5-5" works too (issue #199).
    // "claude-code" follows "anthropic" (ADR-0037 §1), with the same Claude models pinned. It is
    // tried only for the owner's own conversations, and only while the owner's switch is on (#295).
    "MODEL_ROUTES": {
      "cheap": [
        { "provider": "anthropic", "model": "haiku" },
        { "provider": "claude-code", "model": "claude-haiku-5-5" },
        { "provider": "openai", "model": "gpt-6-luna" }
      ],
      "medium": [
        { "provider": "anthropic", "model": "claude-sonnet-5-5" },
        { "provider": "claude-code", "model": "claude-sonnet-5-5" },
        { "provider": "openai", "model": "gpt-6.1-sol" }
      ],
      "frontier": [
        { "provider": "anthropic", "model": "claude-opus-5-5" },
        { "provider": "claude-code", "model": "claude-opus-5-5" },
        { "provider": "openai", "model": "gpt-6-astra" }
      ]
    },
    // "off" stops a turn at the first route that fails, with a notice, instead of trying the next
    // one; anything else falls back, with a notice too (ADR-0037 §4, #293).
    "MODEL_FALLBACK": "on"
  }
}
