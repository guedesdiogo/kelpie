{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "kelpie-llm-gateway",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  // Reached only through service bindings from Kelpie's other Workers.
  "workers_dev": false,
  "preview_urls": false,
  // Clef, the default end-of-turn qualifier, runs on Workers AI and needs no key (issue #118).
  "ai": { "binding": "AI" },
  "vars": {
    // To go through AI Gateway, override these with --var when deploying (docs/admin-api.md),
    // so the instance's account id stays out of the repository:
    // https://gateway.ai.cloudflare.com/v1/<account>/<gateway>/anthropic and .../openai
    "ANTHROPIC_BASE_URL": "https://api.anthropic.com",
    "OPENAI_BASE_URL": "https://api.openai.com/v1",
    // Jev's version for end of turn, pinned: its thresholds were measured on it (ADR-0018).
    "JEV_MODEL": "jev-1.13.0",
    // Clef's model for end of turn, "clef" or "clef-flash", pinned like Jev's: each has its own
    // bands (ADR-0022).
    "CLEF_MODEL": "clef",
    // The vault's embedding model: "workers-ai" (bge-m3) or "openai" (text-embedding-3-small).
    "EMBEDDING_PROVIDER": "workers-ai",
    // For each tier, the models to try in order. Owner configuration; edit freely.
    // "haiku" is Kelpie's alias for the newest Claude Haiku, looked up in Anthropic's Models API
    // once an hour; a pinned id such as "claude-haiku-5-5" works too (issue #199).
    "MODEL_ROUTES": {
      "cheap": [
        { "provider": "anthropic", "model": "haiku" },
        { "provider": "openai", "model": "gpt-6-luna" }
      ],
      "medium": [
        { "provider": "anthropic", "model": "claude-sonnet-5-5" },
        { "provider": "openai", "model": "gpt-6.1-sol" }
      ],
      "frontier": [
        { "provider": "anthropic", "model": "claude-opus-5-5" },
        { "provider": "openai", "model": "gpt-6-astra" }
      ]
    }
  }
}
